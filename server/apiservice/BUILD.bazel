load("@rules_go//go:def.bzl", "go_library")
load("@rules_ogen_go//:ogen.bzl", "ogen_go")

ogen_go(
    name = "ogen",
    src = "//api",
    package = "apiservice",
)

go_library(
    name = "apiservice",
    srcs = [
        "apiservice.go",
        "hi.go",
        "thing.go",
    ],
    embed = [":ogen"],
    importpath = "github.com/jaqx0r/example-bazel-cue-openapi/server/apiservice",
    visibility = ["//server:__pkg__"],
    deps = [
        "@com_github_google_uuid//:uuid",
        "@com_github_jaqx0r_pagination//:pagination",
    ],
)
